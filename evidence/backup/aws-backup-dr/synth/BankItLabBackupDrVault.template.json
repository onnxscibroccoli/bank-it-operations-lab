{
 "Description": "AWS Backup DR copy vault, intended region us-west-2 (static synthesis lab; not deployed)",
 "Rules": {
  "PinRegion": {
   "Assertions": [
    {
     "Assert": {
      "Fn::Equals": [
       {
        "Ref": "AWS::Region"
       },
       "us-west-2"
      ]
     },
     "AssertDescription": "This stack may only be deployed in us-west-2."
    }
   ]
  },
  "CheckBootstrapVersion": {
   "Assertions": [
    {
     "Assert": {
      "Fn::Not": [
       {
        "Fn::Contains": [
         [
          "1",
          "2",
          "3",
          "4",
          "5"
         ],
         {
          "Ref": "BootstrapVersion"
         }
        ]
       }
      ]
     },
     "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI."
    }
   ]
  }
 },

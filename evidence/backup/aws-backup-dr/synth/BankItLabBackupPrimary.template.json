{
 "Description": "AWS Backup vault, plan, cross-region copy and restore testing, intended region us-east-1 (static synthesis lab; not deployed)",
 "Rules": {
  "PinRegion": {
   "Assertions": [
    {
     "Assert": {
      "Fn::Equals": [
       {
        "Ref": "AWS::Region"
       },
       "us-east-1"
      ]
     },
     "AssertDescription": "This stack may only be deployed in us-east-1."
    }
   ]
  },
  "CheckBootstrapVersion": {
   "Assertions": [
    {
     "Assert": {
      "Fn::Not": [
       {
        "Fn::Contains": [
         [
          "1",
          "2",
          "3",
          "4",
          "5"
         ],
         {
          "Ref": "BootstrapVersion"
         }
        ]
       }
      ]
     },
     "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI."
    }
   ]
  }
 },

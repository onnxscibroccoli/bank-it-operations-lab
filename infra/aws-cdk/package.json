{
  "name": "bank-it-lab-aws-cdk",
  "version": "0.1.0",
  "private": true,
  "description": "Credential-free CDK synthesis: secure S3 storage + private VPC/PostgreSQL, cdk-nag AwsSolutions + NIST 800-53 R5 (static evidence only).",
  "bin": {
    "bank-it-lab-aws-cdk": "bin/app.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest --ci",
    "synth": "cdk synth --no-lookups --no-version-reporting --path-metadata false"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "aws-cdk-lib": "2.275.0",
    "cdk-nag": "2.38.2",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "20.19.43",
    "aws-cdk": "2.1146.1",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}

{
  "name": "bank-it-lab-orgs",
  "version": "0.1.0",
  "private": true,
  "description": "Credential-free reference modules: AWS Organizations OU layout + SCPs, organization CloudTrail, GuardDuty and Security Hub (static synthesis and policy linting only; never deployed).",
  "scripts": {
    "build": "tsc",
    "test": "jest --ci",
    "synth": "cdk synth --no-lookups --no-version-reporting --no-path-metadata --no-asset-metadata --quiet",
    "export:policies": "ts-node scripts/export-policies.ts",
    "lint:policies": "ts-node scripts/lint-policies.ts"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "aws-cdk-lib": "2.275.0",
    "cdk-nag": "2.38.2",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "20.19.43",
    "aws-cdk": "2.1146.1",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}

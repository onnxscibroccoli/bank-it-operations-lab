{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": [
      "id",
      "description",
      "category",
      "audience",
      "lifecycle_status",
      "current_state",
      "limitations",
      "planned",
      "source_files",
      "related_development",
      "aliases",
      "verification"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "description": {
        "type": "string",
        "minLength": 20
      },
      "category": {
        "type": "string"
      },
      "audience": {
        "type": "array",
        "minItems": 1,
        "items": {
          "enum": [
            "beginner",
            "operator",
            "engineer",
            "architect",
            "reference"
          ]
        }
      },
      "lifecycle_status": {
        "enum": [
          "Concept",
          "Proposed",
          "Planned",
          "In Development",
          "Experimental",
          "Simulated",
          "Locally Verified",
          "CI Verified",
          "Integration Verified",
          "Production Verified",
          "Stable",
          "Deprecated",
          "Archived"
        ]
      },
      "current_state": {
        "type": "string"
      },
      "limitations": {
        "type": "string"
      },
      "planned": {
        "type": "string"
      },
      "source_files": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "related_development": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "aliases": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "verification": {
        "type": "object",
        "required": [
          "level",
          "scope",
          "last_verified",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "level": {
            "enum": [
              "Not established",
              "Concept",
              "Proposed",
              "Planned",
              "In Development",
              "Experimental",
              "Simulated",
              "Locally Verified",
              "CI Verified",
              "Integration Verified",
              "Production Verified",
              "Stable",
              "Deprecated",
              "Archived"
            ]
          },
          "scope": {
            "type": "string"
          },
          "last_verified": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}

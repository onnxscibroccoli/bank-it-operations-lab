{
  "Name": "bank-lab-al2023-security",
  "Description": "EXAMPLE ONLY - AL2023 security+bugfix baseline with delayed auto-approval (aws ssm create-patch-baseline --cli-input-json)",
  "OperatingSystem": "AMAZON_LINUX_2023",
  "ApprovalRules": {
    "PatchRules": [
      {
        "PatchFilterGroup": {
          "PatchFilters": [
            {"Key": "CLASSIFICATION", "Values": ["Security"]},
            {"Key": "SEVERITY", "Values": ["Critical", "Important"]}
          ]
        },
        "ComplianceLevel": "CRITICAL",
        "ApproveAfterDays": 3,
        "EnableNonSecurity": false
      },
      {
        "PatchFilterGroup": {
          "PatchFilters": [
            {"Key": "CLASSIFICATION", "Values": ["Security", "Bugfix"]},
            {"Key": "SEVERITY", "Values": ["Medium", "Low"]}
          ]
        },
        "ComplianceLevel": "MEDIUM",
        "ApproveAfterDays": 14,
        "EnableNonSecurity": false
      }
    ]
  },
  "ApprovedPatches": [],
  "ApprovedPatchesComplianceLevel": "HIGH",
  "RejectedPatches": [],
  "RejectedPatchesAction": "BLOCK",
  "Tags": [
    {"Key": "lab", "Value": "bank-it-operations-lab"},
    {"Key": "example-data", "Value": "true"}
  ]
}
